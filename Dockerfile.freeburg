FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY freeburg/requirements-data.txt /tmp/requirements-data.txt
RUN pip install --no-cache-dir -r /tmp/requirements-data.txt ib_async tweepy lxml html5lib numpy
RUN pip install --no-cache-dir "https://codeload.github.com/karhic/causal-trading-engine/tar.gz/08f16c264fdae660f044abbccf512532ba29d9d5"
COPY freeburg /app/freeburg
RUN useradd -r -m appuser && mkdir -p /data && chown appuser:appuser /data
USER appuser
ENTRYPOINT ["python", "-m"]
CMD ["freeburg.deploy.healthcheck"]
